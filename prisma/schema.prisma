// Prisma schema for Nuclon WMS — multi-device sync
// Each device pushes its full snapshot keyed by a deviceId stored in localStorage.
// SQLite is used as a simple, file-based sync target.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A device's full data snapshot. One row per device.
model DeviceSnapshot {
  id        String   @id @default(cuid())
  /// Identifier stored in the device's localStorage (auto-generated uuid).
  deviceId  String   @unique
  /// Display name (browser / user agent info, optional, for debug only).
  label     String?
  /// ISO timestamp of the last sync from the device.
  updatedAt DateTime @updatedAt
  /// Raw JSON blob of the entire store state (products, equipos, etc.)
  payload   String

  @@index([deviceId])
}

/// Optional: lightweight audit log of sync events for debugging.
model SyncLog {
  id        String   @id @default(cuid())
  deviceId  String
  action    String // "push" | "pull"
  bytes     Int
  createdAt DateTime @default(now())

  @@index([deviceId])
}
